{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STAP++ (Bridge-1)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/stap++.exe",
            "args": ["${workspaceFolder}/Bridge-1/Bridge-1.dat"],
            "cwd": "${workspaceFolder}/Bridge-1",
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build stap++ (debug)",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "Debug STAP++ (small_test)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/stap++.exe",
            "args": ["${workspaceFolder}/build/small_test.dat"],
            "cwd": "${workspaceFolder}/build",
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build stap++ (debug)",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "Run STAP++ without debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/stap++.exe",
            "args": ["${workspaceFolder}/Bridge-1/Bridge-1.dat"],
            "cwd": "${workspaceFolder}/Bridge-1",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "build stap++ (release)"
        }
    ]
}
